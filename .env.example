SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=DBT_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=STAGING
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
DBT_PROFILES_DIR=

# Embeddings (Phase 5) — cortex (default) or local
EMBEDDING_PROVIDER=cortex
EMBEDDING_MODEL=snowflake-arctic-embed-m
EMBEDDING_VERSION=v1
EMBEDDING_DIMENSION=768
AI_CONTEXT_TABLE=AI_IR_SUPPLY_CHAIN_CONTEXT
AI_EMBEDDINGS_TABLE=IR_DOCUMENT_EMBEDDINGS

# LLM (Phase 7) — openai (default) or cortex
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
OPENAI_API_KEY=
